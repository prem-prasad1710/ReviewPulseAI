# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=

# Auth.js / NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ENCRYPTION_KEY=

# AI — Chat completions (Groq or OpenAI)
# Groq (preferred for chat): Set GROQ_API_KEY with a gsk_* key
# OpenAI: Set OPENAI_API_KEY with an sk-* key
GROQ_API_KEY=
OPENAI_API_KEY=

# AI — Model overrides
# GROQ_MODEL: Override Groq model (default: openai/gpt-oss-20b, fallback: openai/gpt-oss-120b)
# See https://console.groq.com/docs/models for available models
# GROQ_MODEL=
# LLM_CHAT_MODEL: Override all model selection (takes precedence)
# LLM_CHAT_MODEL=

# AI — Whisper voice transcription (OpenAI only, requires sk-* key)
OPENAI_WHISPER_API_KEY=

# Google Cloud APIs (server-side only)
GOOGLE_PLACES_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Messaging — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_PUBLIC_URL=

# Email — Resend
RESEND_API_KEY=
FROM_EMAIL=

# Rate limiting (optional but recommended for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication
CRON_SECRET=

# Development
NODE_ENV=development
